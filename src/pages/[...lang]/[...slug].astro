---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { getImage } from 'astro:assets';
import Logo from '@/assets/images/logo.png';
import Layout from '@/layouts/Layout.astro';
import { Docs } from '@/components/docs';
import { getPageImage, getPageMarkdownUrl, source } from '@/lib/source';
import { gitConfig, ogData, ogFallback } from '@/lib/shared';
import DocImage from "@/components/doc-image.astro"
export const prerender = true;

const optimizedLogo = await getImage({
  src: Logo,
  width: 64,
  height: 64,
  format: 'webp',
});

export const getStaticPaths = (() => {
  return source.getPages().map((page) => ({
    params: {
      lang: page.locale,
      slug: decodeURI(page.slugs.join('/')) || undefined,
    },
    props: { page },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props;
const { body: Content, toc } = await page.data.load();
const pageTree = await source.serializePageTree(
  source.getPageTree(page.locale),
);
const lang = page.locale ?? Astro.currentLocale ?? 'en-gb';
const subtype = page.path.split('/')[0];
const meta = ogData[subtype as keyof typeof ogData] || ogFallback;
const pageTitle = `${page.data.title} | ${meta.name} Wiki`;
const markdownUrl = getPageMarkdownUrl(page).url;
---

<Layout
  lang={lang}
  title={pageTitle}
  description={page.data.description}
  image={getPageImage(page).url}
>
  <Docs
    client:load
    transition:persist
    pathname={Astro.url.pathname}
    logoSrc={optimizedLogo.src}
    lang={lang}
    params={Astro.params}
    tree={pageTree}
    title={page.data.title}
    description={page.data.description}
    full={page.data.full}
    toc={toc}
    markdownUrl={markdownUrl}
    githubUrl={`https://github.com/${gitConfig.user}/${gitConfig.repo}/blob/${gitConfig.branch}/content/wiki/${encodeURI(page.path)}`}
  >
    <Content components={{ img: DocImage }}/>
  </Docs>
</Layout>